# Set this to the public DNS name whose A record points to the OCI VM.
OPENWA_DOMAIN=wa-api.campusinnovate.com
# Email address used by Let's Encrypt for certificate notices.
ACME_EMAIL=innovatecampus@gmail.com
# Keep the single-device session connected after a VM/container restart.
AUTO_START_SESSIONS=true
# One-number pilot; SQLite is the OpenWA default and persists in openwa-data.
ENGINE_TYPE=whatsapp-web.js
API_PORT=2785
