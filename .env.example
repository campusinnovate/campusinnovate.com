# Instagram Professional account connection for the automatic website feed.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com
INSTAGRAM_GRAPH_VERSION=v25.0

# Secure server-side destination for Contact inquiries (email service, CRM, or Apps Script webhook).
CONTACT_WEBHOOK_URL=
