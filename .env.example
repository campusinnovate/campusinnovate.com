# Ruang Kawan — Prospect Harvester.
# Google Places API (New) must be enabled for Text Search.
GOOGLE_PLACES_API_KEY=

# Meta Threads API token with threads_keyword_search permission.
THREADS_ACCESS_TOKEN=
THREADS_API_HOST=https://graph.threads.net

# AI enrichment, service matching, decision-maker role analysis, and outreach drafting.
OPENAI_API_KEY=
OPENAI_PROSPECT_MODEL=gpt-5-mini

# LinkedIn is intentionally not scraped. Store/link public company/profile URLs in the prospect record.
# If Campus Innovate later receives approved LinkedIn API access, add the official connector here.
LINKEDIN_ACCESS_TOKEN=
